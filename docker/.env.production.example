# SolanaLM Production Environment Configuration
# Copy this file to .env.production and fill in the values

# ===========================================
# REQUIRED SETTINGS (no defaults)
# ===========================================

# Database
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Node Configuration (if running nodes)
INFERENCE_NODE_ID=inference-node-1
INFERENCE_NODE_WALLET=YourInferenceNodeSolanaWalletAddress

TRAINING_NODE_ID=training-node-1
TRAINING_NODE_WALLET=YourTrainingNodeSolanaWalletAddress

# ===========================================
# DOCKER SECRETS (create separately)
# ===========================================
# Create these secrets before running docker-compose:
#
# JWT Secret (min 32 characters):
#   echo "your-very-secure-jwt-secret-key-at-least-32-chars" | docker secret create jwt_secret -
#
# Admin API Key (min 32 characters):
#   echo "your-secure-admin-api-key-at-least-32-characters" | docker secret create admin_api_key -
#
# PostgreSQL Password:
#   echo "your-secure-postgres-password" | docker secret create postgres_password -
#
# Treasury Keyfile (Solana keypair JSON):
#   cat /path/to/your/treasury-keypair.json | docker secret create treasury_keyfile -
#
# Or generate a new keypair:
#   solana-keygen new -o treasury-keypair.json --no-bip39-passphrase
#   cat treasury-keypair.json | docker secret create treasury_keyfile -

# ===========================================
# OPTIONAL SETTINGS
# ===========================================

# SSL Certificates
# Place your certificates in docker/nginx/ssl/:
#   - fullchain.pem (certificate chain)
#   - privkey.pem (private key)
#
# For Let's Encrypt, you can use certbot:
#   certbot certonly --standalone -d your-domain.com
#   cp /etc/letsencrypt/live/your-domain.com/fullchain.pem docker/nginx/ssl/
#   cp /etc/letsencrypt/live/your-domain.com/privkey.pem docker/nginx/ssl/

# Domain configuration (update in nginx.conf)
# DOMAIN=your-domain.com

# Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://your-frontend.com,https://app.your-domain.com
